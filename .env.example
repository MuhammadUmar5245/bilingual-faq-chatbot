# Copy to .env and adjust. Used by docker-compose and the Flask API.
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# Database: Postgres in Docker; leave empty for local SQLite (backend/instance/faq.db)
DATABASE_URL=postgresql+psycopg2://faq:faqpass@db:5432/faqbot
POSTGRES_DB=faqbot
POSTGRES_USER=faq
POSTGRES_PASSWORD=faqpass

# Default admin account (created on first start if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# NLP
CONFIDENCE_THRESHOLD=0.75
SBERT_THRESHOLD=0.35
FUSION_WEIGHT=0.6
SBERT_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ENABLE_SBERT=1

# Rate limit for POST /api/chat
CHAT_RATE_LIMIT=60 per minute

# Fallback contact details shown when no FAQ matches (FR-05)
COLLEGE_NAME=Student Services Office
CONTACT_PHONE=+968 2400 0000
CONTACT_EMAIL=info@college.edu.om
CONTACT_HOURS=Sun-Thu, 8:00-15:00

# Host port for the web container (Nginx)
WEB_PORT=8088
